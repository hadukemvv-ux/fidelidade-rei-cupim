# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Security - Customer session
# Required dedicated HMAC secret for customer sessions and OTP challenge records.
# Generate a high-entropy value and never reuse SUPABASE_SERVICE_ROLE_KEY here.
CUSTOMER_SESSION_SECRET=your-secure-customer-session-secret

# Administrative access is configured in /admin/operadores through active
# operational roles (caixa, gestor or superadmin). No e-mail allowlist or shared
# administrative token is supported.

# Security - Cron Jobs
# Used to protect /api/cron/* endpoints
CRON_SECRET=your-secure-cron-token-here

# Saipos Integration (server-only secrets; never use NEXT_PUBLIC_)
# API de Consulta de Dados: required only for the read-only diagnostic and
# future validated integration. Store as a Production Secret in Vercel.
SAIPOS_DATA_API_TOKEN=your-saipos-data-api-token
# Identificador público-operacional da loja, used only on the server.
SAIPOS_ID=your-saipos-store-id
# Reserved for a future, officially documented Saipos webhook. Do not reuse the
# Data API token; the current webhook route remains paused.
SAIPOS_WEBHOOK_SECRET=your-future-saipos-webhook-secret

# Local test credentials (optional, recommended for integration tests)
ADMIN_TEST_EMAIL=admin@example.com
ADMIN_TEST_PASSWORD=your-admin-password

# Environment
NODE_ENV=production
ENVIRONMENT=production

# WhatsApp OTP via Twilio Verify. Mantenha false até concluir a configuração
# do remetente, revisar preços e cadastrar os telefones do beta.
WHATSAPP_OTP_ENABLED=false
WHATSAPP_OTP_BETA_ONLY=true
WHATSAPP_OTP_BETA_PHONES=5585988887777,5585977776666
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Travas de custo (o servidor também bloqueia chamadas concorrentes no banco)
OTP_RESEND_SECONDS=60
OTP_MAX_PER_PHONE_HOUR=3
OTP_MAX_PER_IP_HOUR=10
OTP_MAX_GLOBAL_DAY=30

# Examples of secure token generation:
# For CRON_SECRET: openssl rand -base64 32
# For CUSTOMER_SESSION_SECRET: openssl rand -base64 32
