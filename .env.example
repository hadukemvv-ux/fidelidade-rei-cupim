# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Security - Admin Authentication
# Recommended: use Supabase session auth plus an allowlist of admin emails
ADMIN_ALLOWED_EMAILS=admin@example.com,owner@example.com

# Optional legacy fallback for /api/admin/* endpoints during transition
ADMIN_SECRET_TOKEN=your-secure-admin-token-here

# Security - Cron Jobs
# Used to protect /api/cron/* endpoints
CRON_SECRET=your-secure-cron-token-here

# Saipos Integration
# Token for Saipos API access
SAIPOS_TOKEN=your-saipos-api-token

# Local test credentials (optional, recommended for integration tests)
ADMIN_TEST_EMAIL=admin@example.com
ADMIN_TEST_PASSWORD=your-admin-password

# Environment
NODE_ENV=production
ENVIRONMENT=production

# Examples of secure token generation:
# For CRON_SECRET: openssl rand -base64 32
# For optional ADMIN_SECRET_TOKEN: openssl rand -base64 32
